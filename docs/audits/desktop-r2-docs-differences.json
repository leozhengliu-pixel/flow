  "causes": {
    "composer": {
      "classification": "product decision needed",
      "reason": "Submit comment starts at 750.5px instead of 749px. The captured draft allocates 306px to the editor/action group; the responsive group receives 308px. Captured padding, selection inset, action margin and control dimensions already match. A missing sizing contract cannot be recovered from the capture without a fitted shrink. Supply the source sizing declaration or approve retaining responsive sizing; this remains FAIL."
    },
    "menuCapture": {
      "classification": "fixture cannot match",
      "reason": "The captured menu geometry is consistent with a 98% scale: Duplicate is 57.15px versus settled 58.313px with identical declared 13px/450 typography; 32px rows measure 31.36px. The capture lacks the scale declaration/origin and animation timing. Reproducing transitional glyph bounds would require a fitted transform. No font-size or geometry tolerance was changed."
    },
    "subscriberCapture": {
      "classification": "fixture cannot match",
      "reason": "Captured subscriber text is consistent with a 98% scale: Skyler Anderson is 100.25px versus settled 102.297px; zheng liu is 54.96px versus 56.086px. The heading edge is also shifted. The scale declaration/origin and animation timing were not recorded; no fitted transform or smaller font was added."
    },
    "subscriberPaint": {
      "classification": "fixture cannot match",
      "reason": "The immutable JSON records a filled metadata trigger and transparent bell; its PNG shows a filled bell and unfilled metadata trigger. Those capture states cannot be reproduced together. The fixture preserves the visible PNG state; the computed-style comparison remains FAIL."
    },
    "applicationRoster": {
      "classification": "fixture cannot match",
      "reason": "Agent follows the application member name. The captured roster includes a different built-in application identity. Flow retains its own identity, so the badge x cannot match by changing fixture human names. Human names, roles, subscriptions and badge styling have been aligned."
    },
    "unrecordedInk": {
      "classification": "fixture cannot match",
      "reason": "The captured computed foreground does not appear in its PNG crop. Ancestor opacity, hover and timing were not recorded, so the computed value alone cannot establish visible ink. This inherited evidence limit is withheld, not an assertion of parity."
    },
    "sparseBody": {
      "classification": "fixture cannot match",
      "reason": "The reference has three eligible body controls plus one meaningful editor wrapper, below the unchanged five-body-node coverage floor. Numeric fixture text is not a UI-label match. Adding empty wrappers or counting the editor twice would fabricate coverage."
    }
  },
