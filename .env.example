# Core
FLOW_APP_URL=http://127.0.0.1:5173
FLOW_COOKIE_SECURE=false
FLOW_DEV_AUTH_TOKENS=true

# Database: sqlite | postgres | mysql
FLOW_DATABASE_DRIVER=sqlite
FLOW_DATABASE_PATH=/app/data/flow.db
# PostgreSQL: postgres://flow:password@postgres:5432/flow?sslmode=disable
# MySQL:      mysql://flow:password@mysql:3306/flow
FLOW_DATABASE_URL=
FLOW_DATABASE_MAX_OPEN_CONNS=0
FLOW_DATABASE_MAX_IDLE_CONNS=0
FLOW_DATABASE_CONN_MAX_LIFETIME=30m

# Shared coordination: disabled | standalone | cluster
# Multi-instance deployments require PostgreSQL/MySQL plus Redis.
FLOW_REDIS_MODE=disabled
# Standalone example: redis://default:password@redis:6379/0
# Cluster URL can include extra seeds with repeated addr query parameters.
FLOW_REDIS_URL=
# Alternative comma-separated addresses. Cluster example:
# redis-cluster-1:6379,redis-cluster-2:6379,redis-cluster-3:6379
FLOW_REDIS_ADDRS=
FLOW_REDIS_USERNAME=
FLOW_REDIS_PASSWORD=
FLOW_REDIS_DB=0
FLOW_REDIS_TLS=false
FLOW_REDIS_PREFIX=flow
FLOW_REDIS_POOL_SIZE=40
FLOW_REDIS_MIN_IDLE_CONNS=5
FLOW_REDIS_DIAL_TIMEOUT=5s
FLOW_REDIS_READ_TIMEOUT=3s
FLOW_REDIS_WRITE_TIMEOUT=3s
FLOW_REDIS_CONNECT_TIMEOUT=15s
FLOW_REDIS_LOCK_TTL=30s
FLOW_REDIS_LOCK_WAIT=5s

# Object storage: local | s3
FLOW_STORAGE_DRIVER=local
FLOW_STORAGE_LOCAL_PATH=/app/data/uploads
FLOW_S3_BUCKET=
FLOW_S3_REGION=
FLOW_S3_ENDPOINT=
FLOW_S3_ACCESS_KEY_ID=
FLOW_S3_SECRET_ACCESS_KEY=
FLOW_S3_PATH_STYLE=false
FLOW_S3_PREFIX=uploads
FLOW_S3_VALIDATE_ON_START=true

# Authentication providers
FLOW_AUTH_EMAIL_ENABLED=true
FLOW_AUTH_AUTO_PROVISION=true
FLOW_AUTH_ALLOWED_DOMAINS=

FLOW_AUTH_GOOGLE_ENABLED=false
FLOW_GOOGLE_CLIENT_ID=
FLOW_GOOGLE_CLIENT_SECRET=
FLOW_GOOGLE_REDIRECT_URL=

FLOW_AUTH_OIDC_ENABLED=false
FLOW_OIDC_ISSUER_URL=
FLOW_OIDC_CLIENT_ID=
FLOW_OIDC_CLIENT_SECRET=
FLOW_OIDC_SCOPES=openid profile email
FLOW_OIDC_DISPLAY_NAME=OpenID Connect
# Stable claim used to bind an external identity. Keep `sub` unless the IdP
# explicitly guarantees an immutable employee identifier claim.
FLOW_OIDC_IDENTITY_CLAIM=sub

FLOW_AUTH_SAML_ENABLED=false
FLOW_SAML_METADATA_URL=
FLOW_SAML_METADATA_XML=
FLOW_SAML_ENTITY_ID=
FLOW_SAML_ACS_URL=
FLOW_SAML_SP_PRIVATE_KEY=
FLOW_SAML_SP_CERTIFICATE=
FLOW_SAML_DISPLAY_NAME=SAML

# Flow Agent (OpenAI-compatible Chat Completions API)
FLOW_AGENT_ENABLED=false
FLOW_AGENT_BASE_URL=https://api.openai.com/v1
FLOW_AGENT_API_KEY=
FLOW_AGENT_MODEL=gpt-5-mini
FLOW_AGENT_TIMEOUT=60s

# OpenTelemetry. Standard OTEL_* variables configure the destination.
FLOW_TELEMETRY_ENABLED=false
FLOW_ENVIRONMENT=production
OTEL_SERVICE_NAME=flow-api
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=
OTEL_EXPORTER_OTLP_METRICS_ENDPOINT=
OTEL_EXPORTER_OTLP_HEADERS=
OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
