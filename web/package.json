{
  "name": "flow-web",
  "private": true,
  "version": "0.1.0",
  "description": "Flow web application",
  "license": "Apache-2.0",
  "packageManager": "npm@10.9.2",
  "engines": {
    "node": ">=24.19.0 <25 || >=26.0.0 <27",
    "npm": ">=10 <11"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/leozhengliu-pixel/flow.git",
    "directory": "web"
  },
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:coverage:workflows": "vitest run --coverage --config vitest.workflows.config.ts",
    "test:coverage:all": "vitest run --coverage --config vitest.all.config.ts",
    "test:e2e": "playwright test",
    "lint": "oxlint && npm run check:pickers && npm run check:design-tokens && npm run check:ui-foundations && npm run check:functional-controls",
    "check:pickers": "node scripts/check-picker-architecture.mjs",
    "check:design-tokens": "node scripts/check-design-token-colors.mjs",
    "check:ui-foundations": "node scripts/check-ui-foundations.mjs",
    "check:functional-controls": "node scripts/check-functional-controls.mjs",
    "preview": "vite preview"
  },
  "dependencies": {
    "@nivo/bar": "^0.99.0",
    "@nivo/line": "^0.99.0",
    "@radix-ui/react-avatar": "^1.2.6",
    "@radix-ui/react-context-menu": "^2.3.7",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-popover": "^1.1.23",
    "@radix-ui/react-select": "^2.3.7",
    "@radix-ui/react-separator": "^1.1.15",
    "@radix-ui/react-slot": "^1.3.3",
    "@radix-ui/react-tooltip": "^1.2.16",
    "@tailwindcss/vite": "^4.3.3",
    "@tiptap/extension-collaboration": "^3.30.5",
    "@tiptap/extension-collaboration-caret": "^3.30.5",
    "@tiptap/extension-placeholder": "^3.30.5",
    "@tiptap/markdown": "^3.30.5",
    "@tiptap/react": "^3.30.5",
    "@tiptap/starter-kit": "^3.30.5",
    "@tiptap/y-tiptap": "^3.0.9",
    "chrono-node": "^2.10.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.4.0",
    "lucide-react": "^1.31.0",
    "prosemirror-model": "^1.25.11",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.2",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3",
    "y-prosemirror": "^1.3.7",
    "y-protocols": "^1.0.7",
    "yjs": "^13.6.32"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.8.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.6",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^6.0.4",
    "@vitest/coverage-v8": "^4.1.11",
    "jsdom": "^30.0.1",
    "oxlint": "^1.75.0",
    "typescript": "~6.0.2",
    "vite": "^8.2.0",
    "vitest": "^4.1.11"
  }
}
